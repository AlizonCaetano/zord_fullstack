    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "5.4"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
